	cpus {
		#size-cells = <0x00>;
		#address-cells = <0x02>;

		cpu@400 {
			#cooling-cells = <0x02>;
			phandle = <0x14>;
			enable-method = "psci";
			reg = <0x00 0x400>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x0a>;
		};

		cpu@100 {
			#cooling-cells = <0x02>;
			phandle = <0x11>;
			enable-method = "psci";
			reg = <0x00 0x100>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x07>;
		};

		cpu@0 {
			#cooling-cells = <0x02>;
			phandle = <0x10>;
			enable-method = "psci";
			reg = <0x00 0x00>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x04>;

			l2-cache {
				phandle = <0x05>;
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
			};
		};

		cpu@500 {
			#cooling-cells = <0x02>;
			phandle = <0x15>;
			enable-method = "psci";
			reg = <0x00 0x500>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x0b>;
		};

		cpu@10000 {
			#cooling-cells = <0x02>;
			phandle = <0x16>;
			enable-method = "psci";
			reg = <0x00 0x10000>;
			next-level-cache = <0x0e>;
			dynamic-power-coefficient = <0x24c>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x0c>;
			clocks = <0x06 0x01>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x766>;
			power-domains = <0x0d>;

			l2-cache {
				phandle = <0x0e>;
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
			};
		};

		cpu@200 {
			#cooling-cells = <0x02>;
			phandle = <0x12>;
			enable-method = "psci";
			reg = <0x00 0x200>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x08>;
		};

		cpu-map {

			cluster1 {

				core0 {
					cpu = <0x16>;
				};

				core1 {
					cpu = <0x17>;
				};
			};

			cluster0 {

				core0 {
					cpu = <0x10>;
				};

				core2 {
					cpu = <0x12>;
				};

				core4 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x11>;
				};

				core3 {
					cpu = <0x13>;
				};

				core5 {
					cpu = <0x15>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			large-cluster-cl5 {
				min-residency-us = <0x23b8>;
				phandle = <0x1e>;
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				exit-latency-us = <0x7bf>;
				idle-state-name = "ret-pll-off";
				entry-latency-us = <0x866>;
			};

			medium-cluster-cl5 {
				min-residency-us = <0x23b8>;
				phandle = <0x1d>;
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				exit-latency-us = <0x7bf>;
				idle-state-name = "ret-pll-off";
				entry-latency-us = <0x866>;
			};

			large-cluster1-c4 {
				min-residency-us = <0x2ae>;
				phandle = <0x0c>;
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x04>;
				exit-latency-us = <0x82>;
				idle-state-name = "ret";
				entry-latency-us = <0xac>;
			};

			medium-cluster0-c4 {
				min-residency-us = <0x230>;
				phandle = <0x03>;
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x04>;
				exit-latency-us = <0x81>;
				idle-state-name = "ret";
				entry-latency-us = <0x5d>;
			};

			cluster-ss3 {
				min-residency-us = <0x27a6>;
				phandle = <0x1f>;
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x200c354>;
				exit-latency-us = <0x1130>;
				idle-state-name = "apps-pc";
				entry-latency-us = <0xaf0>;
			};
		};

		cpu@10100 {
			#cooling-cells = <0x02>;
			phandle = <0x17>;
			enable-method = "psci";
			reg = <0x00 0x10100>;
			next-level-cache = <0x0e>;
			dynamic-power-coefficient = <0x24c>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x0c>;
			clocks = <0x06 0x01>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x766>;
			power-domains = <0x0f>;
		};

		cpu@300 {
			#cooling-cells = <0x02>;
			phandle = <0x13>;
			enable-method = "psci";
			reg = <0x00 0x300>;
			next-level-cache = <0x05>;
			dynamic-power-coefficient = <0xee>;
			compatible = "arm,armv8";
			device_type = "cpu";
			cpu-idle-states = <0x03>;
			clocks = <0x06 0x00>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x700>;
			power-domains = <0x09>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
		phandle = <0x357>;
