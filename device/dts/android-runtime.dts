			arm,primecell-periphid = <0xbb909>;

			out-ports {
				#size-cells = <0x00>;
				#address-cells = <0x01>;

				port@0 {

					endpoint {
						phandle = <0x254>;
						remote-endpoint = <0x253>;
					};
				};
			};

			in-ports {

				port {

