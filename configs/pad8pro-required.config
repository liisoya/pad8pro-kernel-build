# Xiaomi Pad 8 Pro (piano) 必需驱动 —— 覆盖 universal_defconfig 的遗漏
#
# 为什么需要这个文件：
# 内核 kbuild 的 %_defconfig 目标使用 allnoconfig 语义，即
# 「universal_defconfig 里没写到的选项 = n」。而 universal_defconfig
# （8435 行）没有列出下面这几个 Pad 8 Pro 必需驱动，直接用它构建
# 会得到一台黑屏、键盘不可用的平板。
#
# 已核实：这些符号在内核 Kconfig 中确实存在
#   CONFIG_DRM_PANEL_NOVATEK_NT36532  drivers/gpu/drm/panel/Kconfig
#                                       （help 里写明 used in the Xiaomi Pad 8 Pro tablet）
#   CONFIG_HID_NANOSIC                 drivers/hid/Kconfig
#   CONFIG_CHARGER_SC8541              drivers/power/supply/Kconfig
#   CONFIG_CHARGER_SC96231             drivers/power/supply/Kconfig
#
# 写法说明：这里用 =m 而不是 =y，是为了不改变作者的构建策略（他的
# universal_defconfig 大量使用 =m）。若某个符号在对应 Kconfig 中不存在，
# olddefconfig 会静默丢弃，CI 会把它报为 WARN 而不是静默失效。

# 显示：Novatek NT36532 DDIC + BOE 3200x2136 双 DSI DSC 面板
CONFIG_DRM_PANEL_NOVATEK_NT36532=m

# 磁吸键盘 + Precision Touchpad（Nanosic 803 MCU，走 I2C）
# 固件要求：nanosic/MCU_Upgrade.bin
CONFIG_HID_NANOSIC=m

# 有线充电（Southchip SC8541 充电泵）
CONFIG_CHARGER_SC8541=m

# 无线充电（Southchip SC96231 发射端）
CONFIG_CHARGER_SC96231=m

# 音频：FourSemi FS19xx 智能功放（ticket 02）
#
# piano.dts 有 4 个扬声器节点（spk_tl/tr/bl/br），compatible = "foursemi,fs19xx"，
# 驱动在 sound/soc/codecs/fs19xx.c，Kconfig 符号 SND_SOC_FS19XX（该 commit 实存）。
# universal_defconfig 只有同族的 FS210X（5310 行），FS19XX 未启用 → 功放不编译
# → 声卡注册失败（speaker-dai-link 绑定不上 codec）。
# 依赖：depends on I2C（实测 =m，满足）；select CRC16 / REGMAP_I2C 自动满足。
# 声卡机器驱动 qcom,sm8750-sndcard 由 SND_SOC_SC8280XP（sc8280xp.c 匹配表含
# sm8750-sndcard）提供，universal_defconfig 已有 =m，无需在此重复。
CONFIG_SND_SOC_FS19XX=m
